# ── Servidor ────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── JWT ─────────────────────────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_STRONG_SECRET_64_CHARS_MIN
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_STRONG_SECRET_64_CHARS_MIN
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Admin ────────────────────────────────────────────────────────────
# Contraseña del panel admin (se hashea al arrancar si no existe en DB)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── API Key para n8n ─────────────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_API_KEY=CHANGE_ME_RANDOM_64_HEX_CHARS

# ── CORS ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,https://serenia.io

# ── SQLite ───────────────────────────────────────────────────────────
DB_PATH=./data/serenia.db
